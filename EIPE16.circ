  <vhdl name="SignalDelayer">--------------------------------------------------------------------------------
-- Project :
-- Signal Delayer
-- File    :
-- SignalDelayer
-- Autor   :
-- Comple (CompleCwaft)
-- Date    :
-- 3/29/26
--
--------------------------------------------------------------------------------
-- Description :
-- Delays a signal from propogating in 250 tick intervals
--
--------------------------------------------------------------------------------

LIBRARY ieee;
USE ieee.std_logic_1164.all;
ENTITY SignalDelayer IS
  PORT (
  ------------------------------------------------------------------------------
  --Insert input ports below
    clock      : IN  std_logic;                    -- input bit example
    val        : IN  std_logic_vector(3 DOWNTO 0); -- input vector example
  ------------------------------------------------------------------------------
  --Insert output ports below
    clockOut  : OUT std_logic                      -- output bit example
  );
END SignalDelayer;

--------------------------------------------------------------------------------
--Complete your VHDL description below
--------------------------------------------------------------------------------

ARCHITECTURE TypeArchitecture OF SignalDelayer IS

BEGIN
    p_Process: PROCESS (clock) BEGIN
        clockOut = clock;
    END PROCESS p_Process;

END TypeArchitecture;
</vhdl>
</project>
